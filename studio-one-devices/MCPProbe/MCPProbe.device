	vendor="StudioOneMCP"
	name="StudioOneMCP Probe"
	classID="{6E1B7A30-2C4D-4F8E-9A51-3D7C0B9E4F12}"
	category="Surface"
	nativeCode="JSControlSurfaceDevice"
	deviceScriptFile="ProbeDevice.js"
	deviceScriptFile.functionName="createProbeDevice"
	surfaceFile="MCPProbe.surface.xml"
	componentScriptFile="ProbeComponent.js"
	componentScriptFile.functionName="createProbeComponent"
/>
